# Middleware Configuration
DEBUG=false
PORT=8000

# Chatwoot Configuration
# In docker network: http://chatwoot-web:3000 or public https://chat.yourdomain.com
CHATWOOT_BASE_URL=http://chatwoot-web:3000
CHATWOOT_API_ACCESS_TOKEN=your_chatwoot_admin_or_bot_token_here
CHATWOOT_ACCOUNT_ID=1

# Dify Configuration
# In docker network: http://dify-api:5001/v1 or public https://brain.yourdomain.com/v1
DIFY_API_BASE_URL=http://dify-api:5001/v1
DIFY_API_KEY=app-your_dify_chat_or_workflow_api_key_here
DIFY_TIMEOUT_SECONDS=45.0

# Google Calendar & Scheduling
GOOGLE_CALENDAR_ID=your_clinic_calendar_id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_FILE=google-credentials.json
CLINIC_TIMEZONE=UTC
DEFAULT_APPOINTMENT_DURATION_MINUTES=30

# Typebot Public URL
TYPEBOT_PUBLIC_URL=https://bot.yourdomain.com/clinic-booking

# Handoff Configuration
HANDOFF_LABEL=human-needed
HANDOFF_ASSIGNED_TEAM_ID=0
